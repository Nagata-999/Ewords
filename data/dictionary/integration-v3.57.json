  "preserved_examples": [
    {
      "id": "sw-00091",
      "word": "bad",
      "en": "Bad weather delayed our flight.",
      "ja": "悪天候で私たちの便が遅れました。"
    },
    {
      "id": "sw-00100",
      "word": "beautiful",
      "en": "The garden is beautiful in spring.",
      "ja": "その庭は春になると美しいです。"
    },
    {
      "id": "sw-00121",
      "word": "book",
      "en": "I borrowed a book about birds.",
      "ja": "私は鳥についての本を借りました。"
    },
    {
      "id": "sw-00137",
      "word": "buy",
      "en": "I bought some flowers for my mother.",
      "ja": "母のために花を買いました。"
    },
    {
      "id": "sw-00139",
      "word": "call",
      "en": "We call this game SushiTan.",
      "ja": "私たちはこのゲームをすし単と呼びます。"
    },
    {
      "id": "sw-00139",
      "word": "call",
      "en": "I'll call you tonight.",
      "ja": "今夜電話します。"
    },
    {
      "id": "sw-00139",
      "word": "call",
      "en": "She called my name from the other side of the street.",
      "ja": "彼女は通りの反対側から私の名前を呼びました。"
    },
    {
      "id": "sw-00139",
      "word": "call",
      "en": "They called a technician to repair the heater.",
      "ja": "彼らは暖房器具を直すために技術者を呼びました。"
    },
    {
      "id": "sw-00139",
      "word": "call",
      "en": "I missed your call while I was on the train.",
      "ja": "電車に乗っている間に、あなたからの電話に出られませんでした。"
    },
    {
      "id": "sw-00139",
      "word": "call",
      "en": "Whether to cancel the trip is your call.",
      "ja": "旅行を中止するかどうかは、あなたの判断に任せます。"
    },
    {
      "id": "sw-00156",
      "word": "child",
      "en": "Each child chose a book to take home.",
      "ja": "子どもたちはそれぞれ、家に持ち帰る本を選びました。"
    },
    {
      "id": "sw-00160",
      "word": "class",
      "en": "Our English class begins at nine.",
      "ja": "英語の授業は九時に始まります。"
    },
    {
      "id": "sw-00160",
      "word": "class",
      "en": "There are twenty students in my class.",
      "ja": "私のクラスには二十人の生徒がいます。"
    },
    {
      "id": "sw-00192",
      "word": "day",
      "en": "The journey takes two days.",
      "ja": "その旅には二日かかります。"
    },
    {
      "id": "sw-00192",
      "word": "day",
      "en": "Owls often sleep during the day.",
      "ja": "フクロウは昼間に眠ることがよくあります。"
    },
    {
      "id": "sw-00205",
      "word": "difficult",
      "en": "It was difficult to find the entrance.",
      "ja": "入り口を見つけるのは難しかったです。"
    },
    {
      "id": "sw-00246",
      "word": "family",
      "en": "Our family gets together every winter.",
      "ja": "私たちの家族は毎年冬に集まります。"
    },
    {
      "id": "sw-00275",
      "word": "friend",
      "en": "My friend helped me carry the boxes.",
      "ja": "友人が箱を運ぶのを手伝ってくれました。"
    },
    {
      "id": "sw-00288",
      "word": "good",
      "en": "This is a good place for a picnic.",
      "ja": "ここはピクニックに良い場所です。"
    },
    {
      "id": "sw-00313",
      "word": "home",
      "en": "They invited us into their home.",
      "ja": "彼らは私たちを自宅に招いてくれました。"
    },
    {
      "id": "sw-00313",
      "word": "home",
      "en": "I usually walk home from school.",
      "ja": "私は普段、学校から歩いて帰ります。"
    },
    {
      "id": "sw-00363",
      "word": "learn",
      "en": "We learn a new song every week.",
      "ja": "私たちは毎週、新しい歌を習います。"
    },
    {
      "id": "sw-00364",
      "word": "leave",
      "en": "We leave at seven.",
      "ja": "私たちは7時に出発します。"
    },
    {
      "id": "sw-00364",
      "word": "leave",
      "en": "Leave the door open.",
      "ja": "ドアを開けたままにしてください。"
    },
    {
      "id": "sw-00371",
      "word": "life",
      "en": "He spent most of his life near the sea.",
      "ja": "彼は人生の大半を海の近くで過ごしました。"
    },
    {
      "id": "sw-00371",
      "word": "life",
      "en": "Scientists look for signs of life on other planets.",
      "ja": "科学者たちは他の惑星に生命の痕跡を探しています。"
    },
    {
      "id": "sw-00380",
      "word": "long",
      "en": "It was a long journey, but we enjoyed it.",
      "ja": "長い旅でしたが、私たちは楽しみました。"
    },
    {
      "id": "sw-02839",
      "word": "mass",
      "en": "A large mass of people gathered outside.",
      "ja": "大勢の人々が外に集まった。"
    },
    {
      "id": "sw-00396",
      "word": "mean",
      "en": "I didn't mean to hurt you.",
      "ja": "あなたを傷つけるつもりではありませんでした。"
    },
    {
      "id": "sw-00458",
      "word": "paper",
      "en": "Write your name on a piece of paper.",
      "ja": "紙に名前を書いてください。"
    },
    {
      "id": "sw-00458",
      "word": "paper",
      "en": "She published a paper on language learning.",
      "ja": "彼女は言語学習についての論文を発表しました。"
    },
    {
      "id": "sw-00459",
      "word": "parent",
      "en": "A parent must sign this form.",
      "ja": "保護者の署名がこの用紙に必要です。"
    },
    {
      "id": "sw-00467",
      "word": "person",
      "en": "Only one person can enter at a time.",
      "ja": "一度に入れるのは一人だけです。"
    },
    {
      "id": "sw-00509",
      "word": "school",
      "en": "The school is opposite the station.",
      "ja": "その学校は駅の向かいにあります。"
    },
    {
      "id": "sw-00647",
      "word": "work",
      "en": "She works at a school.",
      "ja": "彼女は学校で働いています。"
    },
    {
      "id": "sw-00647",
      "word": "work",
      "en": "This method really works.",
      "ja": "この方法は本当にうまくいきます。"
    },
    {
      "id": "sw-00651",
      "word": "year",
      "en": "She moved here three years ago.",
      "ja": "彼女は三年前にここに引っ越してきました。"
    }
