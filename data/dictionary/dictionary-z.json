          },
          {
            "ja": "絶頂；最盛期",
            "definition": "the highest point of success, power, or achievement",
            "examples": [
              {
                "en": "The city reached its cultural zenith in the eighteenth century.",
                "ja": "その都市は18世紀に文化的な最盛期を迎えた。"
              },
              {
                "en": "Her career was at its zenith when she won the award.",
                "ja": "その賞を受賞したとき、彼女の経歴は絶頂期にあった。"
              }
            ]
          }
        ]
      }
    ],
    "forms": {},
    "phrases": [],
