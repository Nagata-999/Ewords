{
  "name": "ewords",
  "account_id": "100ebca3da19b2822758fb5728b05b5b",
  "main": "../pin-sync/combined-worker.mjs",
  "compatibility_date": "2026-05-14",
  "workers_dev": true,
  "keep_vars": true,
