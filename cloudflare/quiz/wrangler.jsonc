{
  "name": "ewords-quiz",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-04",
  "account_id": "100ebca3da19b2822758fb5728b05b5b",
  "workers_dev": true,
  "vars": {"QUIZ_READY": "true", "PUBLIC_ORIGIN": "https://sushitan.net"},
  "d1_databases": [{"binding": "DB", "database_name": "sushitan", "database_id": "72087aea-0b5a-4e1f-9cb9-437e88b8677d"}],
  "routes": [{"pattern": "sushitan.net/api/quiz/*", "zone_name": "sushitan.net"}],
  "ratelimits": [{"name": "QUIZ_LIMIT", "namespace_id": "1003", "simple": {"limit": 120, "period": 60}}]
}
